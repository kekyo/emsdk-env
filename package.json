{
  "name": "emsdk-env",
  "version": "0.0.1",
  "description": "Emscripten environment builder",
  "author": "Kouji Matsui (@kekyo@mi.kekyo.net)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kekyo/emsdk-env"
  },
  "homepage": "https://github.com/kekyo/emsdk-env#readme",
  "keywords": [
    "emsdk",
    "emscripten",
    "vite",
    "cli"
  ],
  "readme": "README_pack.md",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite/.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "./images/emsdk-env-120.png"
  ],
  "scripts": {
    "build": "vite build && (cd demo; npm i && npm run build)",
    "test": "npm run build && vitest run",
    "dev": "vite build && (cd demo; npm run dev)",
    "pack": "npm run build && screw-up pack --pack-destination ./artifacts/"
  },
  "dependencies": {
    "async-primitives": ">=1.7.0",
    "glob": ">=13.0.0"
  },
  "peerDependencies": {
    "debug": ">=4.4.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/debug": ">=4.1.0",
    "@types/node": ">=20.0.0",
    "prettier-max": ">=1.14.0",
    "screw-up": ">=1.32.0",
    "typescript": ">=5.0.0",
    "unplugin-dts": ">=1.0.0-beta.6",
    "vite": ">=5.0.0",
    "vitest": ">=1.0.0"
  }
}
